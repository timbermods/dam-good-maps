{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "baseUrl": ".",
    "paths": {
      "three/addons/*": ["node_modules/@types/three/examples/jsm/*"],
      "three": [
        "node_modules/@types/three"
      ],
      "three/*": [
        "node_modules/@types/three/*"
      ],
      "fflate": [
        "node_modules/fflate"
      ]
    }
  },
  "include": [
    "*.ts",
    "scripts",
    "tests"
  ],
  "exclude": [
    "local",
    "tests/parity.ts"
  ]
}
