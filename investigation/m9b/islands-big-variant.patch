+  for (let i = 0; i < N; i++) {
+    const m = lab[i];
+    if (m < 0 || edge.has(m) || (size.get(m) ?? 0) < minSize || keep?.[i] || dist[i] < 1 || h[i] > S + 6) continue;
+    const t = S + 2 + Math.floor((dist[i] - 1) / 5);
+    if (h[i] > t) {
+      h[i] = t;
+      lowered++;
+    }
+  }
