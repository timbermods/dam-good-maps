+/** An island's coast rises gently from the sea (D417): on every island of `minSize` tiles or more
+ *  (dry land over the sea's level, clear of the map's edges), the ground within ten tiles of the sea
+ *  and no more than six levels over it stands no higher than a level over the sea, one more every
+ *  five tiles inland (a start's pad needs five tiles of level ground). Moisture climbs no cliff from the sea, so an island that rose steeply from
+ *  the water was dry ground with no farmland for a start; the coast is walked without stairs.
+ *  `keep` is left as it is. Returns how many tiles were lowered. */
+export function gentleCoasts(h: Uint8Array, W: number, H: number, keep: Uint8Array | null, minSize: number): number {
+  const N = W * H;
+  const S = seaLevel(h, W, H);
+  if (S < 0) return 0;
+  // the islands: masses over S that touch no edge
+  const { lab } = masses(h, W, H, S);
+  const size = new Map<number, number>();
+  const edge = new Set<number>();
+  for (let i = 0; i < N; i++) {
+    if (lab[i] < 0) continue;
+    size.set(lab[i], (size.get(lab[i]) ?? 0) + 1);
+    const x = i % W;
+    const y = (i - x) / W;
+    if (x === 0 || y === 0 || x === W - 1 || y === H - 1) edge.add(lab[i]);
+  }
+  // distance from the sea, over the land, in 4-steps, up to ten
+  const dist = new Int16Array(N).fill(-1);
+  const q: number[] = [];
+  for (let i = 0; i < N; i++) if (h[i] <= S) {
+    dist[i] = 0;
+    q.push(i);
+  }
+  for (let k = 0; k < q.length; k++) {
+    const c = q[k];
+    if (dist[c] >= 10) continue;
+    const x = c % W;
+    const y = (c - x) / W;
+    for (const [dx, dy] of N4) {
+      const xx = x + dx;
+      const yy = y + dy;
+      if (xx < 0 || yy < 0 || xx >= W || yy >= H) continue;
+      const j = yy * W + xx;
+      if (dist[j] >= 0) continue;
+      dist[j] = dist[c] + 1;
+      q.push(j);
+    }
+  }
