+      const old = this.before.fallen.find(g => g.id === f.id);
+      const i = Math.floor(f.y) * raw.W + Math.floor(f.x);
+      if (old && arrival[i] > t) return structuredClone(old);
+      return {...structuredClone(f),z:f.z+out.heights[i]-raw.heights[i]};
+    });
