{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["node"],
    "typeRoots": ["./local/node_modules/@types"],
    "paths": {
      "fflate": ["./local/node_modules/fflate"],
      "ajv": ["./local/node_modules/ajv"]
    }
  },
  "include": ["engine.ts", "resident.ts", "wall.ts", "maps.ts", "check.ts", "demo.ts", "worker.ts", "browser-client.ts", "control-client.ts", "profile-round2.ts", "calibration.ts", "round2-contracts.ts"]
}
