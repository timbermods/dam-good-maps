{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"], "resolveJsonModule": true,
    "esModuleInterop": true, "noEmit": true, "baseUrl": ".",
    "paths": { "three": ["node_modules/@types/three"], "three/*": ["node_modules/@types/three/*"], "fflate": ["node_modules/fflate"] }
  },
  "include": ["*.ts"]
}
