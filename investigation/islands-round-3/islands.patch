+        const yy = y + dy;
+        if (xx < 0 || yy < 0 || xx >= W || yy >= H) continue;
+        const j = yy * W + xx;
+        if (dist[j] >= 0) continue;
+        if (lab[j] >= 0) {
+          if (!reached[lab[j]]) { reached[lab[j]] = 1; grew = true; }
+          continue;
+        }
+        dist[j] = dist[c] + 1;
+        q.push(j);
+      }
+    }
+  }
+  let best = 0;
+  for (let m = 0; m < size.length; m++) if (!edge[m] && reached[m] && size[m] > best) best = size[m];
+  return best;
