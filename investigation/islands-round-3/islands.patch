+    const dist = new Int16Array(N).fill(-1);
+    const q: number[] = [];
+    for (let i = 0; i < N; i++) if (lab[i] >= 0 && reached[lab[i]]) { dist[i] = 0; q.push(i); }
+    for (let k = 0; k < q.length; k++) {
+      const c = q[k];
+      if (dist[c] > strait) continue;
+      const x = c % W;
+      const y = (c - x) / W;
