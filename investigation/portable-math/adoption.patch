+  const n=m<<BigInt(e+104-2*r);
+  let q=1n<<BigInt(Math.ceil(n.toString(2).length/2));
+  for(;;){const next=(q+n/q)>>1n;if(next>=q)break;q=next;}
+  const midpoint=2n*q+1n;if(4n*n>midpoint*midpoint)q++;
