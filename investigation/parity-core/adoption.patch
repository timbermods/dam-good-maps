+    expect(core.ok).toBe(true);
+    const ids = new Set(s.built.entities.map((e) => e.id));
+    for (const tool of ["raise", "lower", "flatten", "smooth", "naturalize"] as const) {
+      const op: EditOp = { op: "brush", params: { tool, dabs: [(x + 2) * 4, (y + 2) * 4], size: 6, strength: 2, ...(tool === "flatten" ? { level: s.built.heights[y * W + x] } : {}), ...(tool === "naturalize" ? { seed: 3 } : {}) } };
+      expect(s.apply(op).ok, tool).toBe(true);
+      expect(s.built.entities.filter((e) => !ids.has(e.id))).toEqual([]);
+    }
+    s.settleCanonical();
+    expect(s.built.entities.filter((e) => !ids.has(e.id))).toEqual([]);
+    if (s.built.entities.some((e) => e.id === core.id)) expect(explosionAfter(s, core.id).entities.filter((e) => !ids.has(e.id))).toEqual([]);
+    const reopened = MapSession.open(decodeProject(s.project()));
+    expect(reopened.built.entities.filter((e) => !ids.has(e.id))).toEqual([]);
+  });
