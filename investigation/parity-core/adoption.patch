+    const made = place(s, "ReservePile", x, y, placeComponents("ReservePile", { good: "Log", amount: 40 }));
+    expect(made.ok).toBe(true);
+    const before = stringify(entityJson(find(s, made.id)));
+    const bad = s.apply({ op: "setEntityProps", params: { id: made.id, components: { FixedStockpile: { FixedGoodId: "Plank" } } } });
+    expect(bad.errors[0]).toMatch(/must agree/);
+    expect(stringify(entityJson(find(s, made.id)))).toBe(before);
+    expect(s.apply({ op: "setEntityProps", params: { id: made.id, components: { "Inventory:Stockpile": { Storage: { Goods: null } } } } }).ok).toBe(false);
