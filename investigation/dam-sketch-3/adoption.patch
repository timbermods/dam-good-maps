+import type { Kernel, State } from './kernel';
+import { compileWall, remapWater, type Snapshot, type Stroke } from './wall';
+import { spillLabels } from './spill';
+export const TICKS_PER_DAY=768;
+export interface Options {
+ fillTicks?:number;
+ /** Explicit observed drought forcing, in the Rust model's emitter order. No random weather. */
