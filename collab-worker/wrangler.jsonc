{
  // The room-code function for collaborative editing (D431). Deployed by .github/workflows/collab-worker.yml.
  "name": "dam-good-maps-collab",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "LIMITERS", "class_name": "Limiter" },
      { "name": "KEEPER", "class_name": "Keeper" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Limiter", "Keeper"] }],
  "vars": {
    "ALLOWED_ORIGINS": "https://timbermods.github.io",
    "ALLOW_LOCAL_ORIGINS": "0",
    "TURN_TTL_SECONDS": "14400",
    "MAX_DAILY_MINTS": "3000",
    "SESSION_TOKEN_TTL_SECONDS": "86400"
  },
  "observability": { "enabled": false }
  // Secrets, set with `wrangler secret put` (the deploy workflow does it): CF_TURN_KEY_ID, CF_TURN_KEY_API_TOKEN.
}
