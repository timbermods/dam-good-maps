{
  "name": "dam-good-maps",
  "version": "0.8.2",
  "private": true,
  "description": "Timberborn map generator: pick settings, preview the map, download a .timber file that plays in Timberborn 1.1.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "setup:machine": "node tools/setup-machine.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "try": "tsx tools/try.ts",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:quick": "vitest run --project quick",
    "test:heavy": "vitest run --project heavy",
    "test:e2e": "playwright test",
    "gen": "tsx tools/gen.ts",
    "places": "tsx tools/real-places.ts",
    "oracle": "tsx tools/oracle.ts",
    "bench": "tsx tools/bench.ts",
    "bench:water": "tsx tools/bench.ts --water",
    "bench:3d": "tsx tools/bench3d.ts",
    "bench:preview": "tsx tools/bench-preview.ts",
    "bench:brush": "tsx tools/bench-brush.ts",
    "smooth": "tsx tools/smooth/run.ts",
    "batch": "tsx tools/batch.ts",
    "sheet": "tsx tools/sheet.ts",
    "fixtures": "python tools/export-fixtures.py",
    "build:spike": "tsx tools/build-spike.ts",
    "spike:check": "tsx tools/build-spike.ts && tsx tools/spike-check.ts"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "comlink": "^4.4.2",
    "fflate": "^0.8.3",
    "preact": "^10.29.8",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.19.1",
    "@types/three": "^0.186.0",
    "@typescript/typescript6": "6.0.2",
    "ajv": "^8.20.0",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
