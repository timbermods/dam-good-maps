{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timbermods.github.io/dam-good-maps/schema/ops-v1.json",
  "title": "Dam Good Maps edit operation v1",
  "description": "One edit operation (EDITOR_PLAN.md §3), the envelope the validation report's fixes also use. Features are checked against the feature schema, and every bound that depends on the map (its size, what exists on it) is checked by the operations engine.",
  "type": "object",
  "additionalProperties": false,
  "required": ["op", "params"],
  "properties": {
    "op": {
      "enum": ["addFeature", "updateFeature", "deleteFeature", "reorderFeature", "sculpt", "brush", "forceResult", "placeEntity", "moveEntity", "deleteEntities", "setEntityProps", "pinSlope", "removeSlope", "removeUnfedWater", "fillHollow", "paintObjects"]
    },
    "params": { "type": "object" },
    "label": { "type": "string" }
  },
  "allOf": [
    { "if": { "properties": { "op": { "const": "addFeature" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/addFeature" } } } },
    { "if": { "properties": { "op": { "const": "updateFeature" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/updateFeature" } } } },
    { "if": { "properties": { "op": { "const": "deleteFeature" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/featureRef" } } } },
    { "if": { "properties": { "op": { "const": "reorderFeature" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/reorderFeature" } } } },
    { "if": { "properties": { "op": { "const": "sculpt" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/sculpt" } } } },
    { "if": { "properties": { "op": { "const": "brush" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/brush" } } } },
    { "if": { "properties": { "op": { "const": "forceResult" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/forceResult" } } } },
    { "if": { "properties": { "op": { "const": "placeEntity" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/placeEntity" } } } },
    { "if": { "properties": { "op": { "const": "moveEntity" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/moveEntity" } } } },
    { "if": { "properties": { "op": { "const": "deleteEntities" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/deleteEntities" } } } },
    { "if": { "properties": { "op": { "const": "setEntityProps" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/setEntityProps" } } } },
    { "if": { "properties": { "op": { "const": "pinSlope" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/pinSlope" } } } },
    { "if": { "properties": { "op": { "const": "removeSlope" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/tile" } } } },
    { "if": { "properties": { "op": { "const": "removeUnfedWater" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/removeUnfedWater" } } } },
    { "if": { "properties": { "op": { "const": "fillHollow" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/fillHollow" } } } },
    { "if": { "properties": { "op": { "const": "paintObjects" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/paintObjects" } } } }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^(f-[a-z2-7]{13}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$" },
    "guid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "coordinate": { "type": "integer", "minimum": 0, "maximum": 255 },
    "orientation": { "enum": ["Cw0", "Cw90", "Cw180", "Cw270"] },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "integer", "minimum": 0, "maximum": 255 } }
    },
    "brush": {
      "description": "A terrain brush stroke (live editing): the brush, and its dabs as quarter-tile pairs [x0, y0, x1, y1, ...]. Its dabs must lie on the map; the engine checks that.",
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "size", "strength", "dabs"],
      "properties": {
        "tool": { "enum": ["raise", "lower", "flatten", "smooth", "naturalize"] },
        "size": { "type": "number", "minimum": 0.5, "maximum": 128 },
        "strength": { "type": "number", "minimum": 1, "maximum": 10 },
        "level": { "type": "integer", "minimum": 0, "maximum": 22 },
        "target": { "type": "integer", "minimum": 0, "maximum": 22 },
        "mode": { "enum": ["ground", "water"] },
        "wet": { "type": "array", "maxItems": 65536, "items": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "integer" } } },
        "bank": { "type": "array", "maxItems": 65536, "items": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "integer" } } },
        "sources": { "const": "keep" },
        "seed": { "type": "integer" },
        "weathers": { "const": true },
        "weathering": { "enum": [2, 3] },
        "rim": { "type": "array", "maxItems": 8192, "items": { "type": "integer", "minimum": 0 } },
        "shore": { "type": "array", "maxItems": 65536, "items": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "integer" } } },
        "pools": { "type": "array", "maxItems": 65536, "items": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "integer" } } },
        "moist": { "type": "array", "maxItems": 65536, "items": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "integer" } } },
        "layer": { "enum": ["top"] },
        "shape": { "enum": ["square", "area"] },
        "precise": { "type": "boolean" },
        "channel": { "type": "boolean" },
        "bed": { "type": "integer", "minimum": 0, "maximum": 22 },
        "dry": { "type": "integer", "minimum": 0 },
        "deepen": { "const": true },
        "slopes": { "type": "array", "maxItems": 4096, "items": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "integer" } } },
        "levels": { "type": "array", "maxItems": 40000, "items": { "type": "integer", "minimum": 1, "maximum": 22 } },
        "stop": { "type": "integer", "minimum": 0, "maximum": 22 },
        "keep": { "type": "array", "maxItems": 65536, "items": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "integer" } } },
        "area": { "type": "array", "maxItems": 65536, "items": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "integer" } } },
        "rigid": { "type": "array", "maxItems": 4096, "items": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "integer", "minimum": 0 } } },
        "steps": { "type": "integer", "minimum": 2, "maximum": 8 },
        "walkable": { "type": "boolean" },
        "edges": { "enum": ["ramped"] },
        "pressure": { "type": "array", "maxItems": 40000, "items": { "type": "integer", "minimum": 1, "maximum": 255 } },
        "dabs": { "type": "array", "minItems": 2, "maxItems": 80000, "items": { "type": "integer", "minimum": 0, "maximum": 1023 } }
      }
    },
    "addFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature"],
      "properties": {
        "feature": { "type": "object" },
        "index": { "type": "integer", "minimum": 0 }
      }
    },
    "updateFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "patch"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "patch": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "params": { "type": "object" }, "locked": { "type": "boolean" } }
        }
      }
    },
    "featureRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": { "id": { "$ref": "#/$defs/id" } }
    },
    "reorderFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "index"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "index": { "type": "integer", "minimum": 0 } }
    },
    "sculpt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "cells"],
      "properties": {
        "mode": { "enum": ["raise", "lower", "flatten", "terrace", "smooth", "naturalize"] },
        "cells": { "$ref": "#/$defs/runs" },
        "amount": { "type": "integer", "minimum": 1, "maximum": 22 },
        "level": { "type": "integer", "minimum": 0, "maximum": 22 },
        "step": { "type": "integer", "minimum": 2, "maximum": 8 },
        "exact": { "type": "boolean" }
      }
    },
    "forceResult": {
      "description": "A force of nature (Carve, Craterize, Erupt, Quake or Glaciate: D194, D202, D203, D206, D220, D246): what the player asked for (the force, its settings, where), and its result stored literally (the changed tiles as indices y·W + x, ascending, and their new levels; the fresh volcanic rock on the tiles where it changed, a bit per level 0–21; the objects that lost their ground, the ones it carried, the trees it knocked down; a carve's source and sealed oxbow lake; a glacier's springs and its tarn; the sources it cleared, D474). Replay assigns the result and never runs the force; the engine checks it fits the map. A project's `carve` operations, from before the forces shared this one, become `forceResult` when it opens.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "verb", "settings", "where", "steps", "reason", "tiles", "heights", "removed"],
      "properties": {
        "version": { "const": 1 },
        "verb": { "enum": ["carve", "craterize", "erupt", "quake", "glaciate", "rift", "deposit"] },
        "settings": {
          "type": "object",
          "required": ["mode", "power", "seed"],
          "properties": {
            "mode": { "enum": ["unleash", "aim", "strike", "vent", "fissure", "lift", "slide", "flow", "drop", "fan"] },
            "power": { "type": "number", "minimum": 0, "maximum": 100 },
            "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
            "wander": { "type": "number", "minimum": 0, "maximum": 100 },
            "width": { "type": ["number", "null"], "minimum": 2, "maximum": 24 },
            "depth": { "type": ["integer", "null"], "minimum": 1, "maximum": 12 },
            "walls": { "enum": ["steep", "wide", "terraced", "auto", "sheer", "stepped"] },
            "defyGravity": { "type": "boolean" },
            "dry": { "type": "boolean" },
            "size": { "type": ["number", "null"], "minimum": 4, "maximum": 180 },
            "centre": { "enum": ["auto", "bowl", "peak", "ring", "flat"] },
            "debris": { "enum": ["light", "heavy"] },
            "rays": { "type": "boolean" },
            "shape": { "enum": ["steep", "broad"] },
            "summit": { "enum": ["auto", "peak", "crater", "caldera"] },
            "flows": { "enum": ["light", "heavy"] },
            "ridges": { "type": "boolean" },
            "scarp": { "enum": ["sheer", "stepped"] },
            "meltwater": { "type": "boolean" },
            "channels": { "enum": ["auto", "few", "many"] },
            "benches": { "enum": ["none", "some", "many"] },
            "steps": { "enum": ["few", "some", "many"] },
            "tarn": { "type": "boolean" },
            "scree": { "type": "boolean" },
            "floor": { "type": "integer", "minimum": 1, "maximum": 22 },
            "riverDepth": { "type": ["integer", "null"], "minimum": 1, "maximum": 22 },
            "banks": { "type": "number", "minimum": 0, "maximum": 10 },
            "sources": { "enum": ["ride", "clear"], "description": "Sources (D474): ride the ground, or clear every water and badwater source on a tile the force changes. Absent: ride (operations from before D474)." }
          }
        },
        "where": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "origin": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/coordinate" } },
            "end": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/coordinate" } },
            "path": { "type": "array", "minItems": 1, "maxItems": 512, "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 0, "maximum": 255 } } },
            "side": { "enum": [1, -1] },
            "source": { "type": "string" }
          }
        },
        "cut": { "type": "integer", "minimum": 0, "maximum": 40 },
        "steps": { "type": "integer", "minimum": 0 },
        "reason": { "type": "string" },
        "tiles": { "type": "array", "maxItems": 65536, "items": { "type": "integer", "minimum": 0, "maximum": 65535 } },
        "heights": { "type": "array", "maxItems": 65536, "items": { "type": "integer", "minimum": 0, "maximum": 255 } },
        "rock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tiles", "bits"],
          "properties": {
            "tiles": { "type": "array", "maxItems": 65536, "items": { "type": "integer", "minimum": 0, "maximum": 65535 } },
            "bits": { "type": "array", "maxItems": 65536, "items": { "type": "integer", "minimum": 0, "maximum": 4194303 } }
          }
        },
        "removed": { "type": "array", "maxItems": 65536, "items": { "$ref": "#/$defs/guid" } },
        "cleared": {
          "description": "Sources set to clear (D474): each source it cleared and the step of its showing that took it.",
          "type": "array",
          "minItems": 1,
          "maxItems": 65536,
          "items": { "type": "object", "additionalProperties": false, "required": ["id", "step"], "properties": { "id": { "$ref": "#/$defs/guid" }, "step": { "type": "integer", "minimum": 0 } } }
        },
        "moved": {
          "type": "array",
          "maxItems": 65536,
          "items": { "type": "object", "additionalProperties": false, "required": ["id", "x", "y"], "properties": { "id": { "$ref": "#/$defs/guid" }, "x": { "$ref": "#/$defs/coordinate" }, "y": { "$ref": "#/$defs/coordinate" } } }
        },
        "felled": {
          "type": "array",
          "maxItems": 65536,
          "items": { "type": "object", "additionalProperties": false, "required": ["id", "dx", "dy"], "properties": { "id": { "$ref": "#/$defs/guid" }, "dx": { "type": "number", "minimum": -1.5, "maximum": 1.5 }, "dy": { "type": "number", "minimum": -1.5, "maximum": 1.5 } } }
        },
        "sources": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "x", "y", "strength"],
            "properties": { "id": { "$ref": "#/$defs/guid" }, "x": { "$ref": "#/$defs/coordinate" }, "y": { "$ref": "#/$defs/coordinate" }, "strength": { "type": "number", "exclusiveMinimum": 0, "maximum": 8 } }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "x", "y", "strength"],
          "properties": { "id": { "$ref": "#/$defs/guid" }, "x": { "$ref": "#/$defs/coordinate" }, "y": { "$ref": "#/$defs/coordinate" }, "strength": { "type": "number", "exclusiveMinimum": 0, "maximum": 8 } }
        },
        "lake": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tiles", "floor", "depth", "contamination"],
          "properties": {
            "tiles": { "type": "array", "maxItems": 65536, "items": { "type": "integer", "minimum": 0, "maximum": 65535 } },
            "floor": { "type": "array", "maxItems": 65536, "items": { "type": "number", "minimum": 0, "maximum": 64 } },
            "depth": { "type": "array", "maxItems": 65536, "items": { "type": "number", "minimum": 0, "maximum": 32 } },
            "contamination": { "type": "array", "maxItems": 65536, "items": { "type": "number", "minimum": 0, "maximum": 1 } }
          }
        },
        "replaces": { "type": "integer", "minimum": 1 }
      }
    },
    "placeEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "template", "x", "y", "orientation"],
      "properties": {
        "id": { "$ref": "#/$defs/guid" },
        "template": { "type": "string" },
        "x": { "$ref": "#/$defs/coordinate" },
        "y": { "$ref": "#/$defs/coordinate" },
        "orientation": { "$ref": "#/$defs/orientation" },
        "flipped": { "type": "boolean" },
        "components": { "$ref": "#/$defs/objectComponents" }
      }
    },
    "moveEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "x", "y"],
      "properties": {
        "id": { "$ref": "#/$defs/guid" },
        "x": { "$ref": "#/$defs/coordinate" },
        "y": { "$ref": "#/$defs/coordinate" },
        "orientation": { "$ref": "#/$defs/orientation" }
      }
    },
    "deleteEntities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entities"],
      "properties": { "entities": { "type": "array", "minItems": 1, "maxItems": 65536, "items": { "$ref": "#/$defs/guid" } } }
    },
    "setEntityProps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "components"],
      "properties": { "id": { "$ref": "#/$defs/guid" }, "components": { "$ref": "#/$defs/objectComponents" } }
    },
    "pinSlope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "orientation"],
      "properties": { "x": { "$ref": "#/$defs/coordinate" }, "y": { "$ref": "#/$defs/coordinate" }, "orientation": { "$ref": "#/$defs/orientation" } }
    },
    "removeUnfedWater": {
      "description": "Remove unfed water (D387 (2)): the water no source feeds, map-wide or within a selection, stored literally as the tiles of the bodies of unfed water it takes (indices y·W + x, ascending; a body with a tile in the selection goes whole). Once the map's water settles, the unfed water on those tiles is taken away and the water settles on from there; water a source feeds is never taken. The engine checks that none of the tiles holds fed water now.",
      "type": "object",
      "additionalProperties": false,
      "required": ["tiles"],
      "properties": {
        "tiles": { "type": "array", "minItems": 1, "maxItems": 65536, "items": { "type": "integer", "minimum": 0, "maximum": 65535 } },
        "area": { "$ref": "#/$defs/runs" },
        "pools": { "type": "integer", "minimum": 0 }
      }
    },
    "fillHollow": {
      "description": "Fill (D387 (3), D394): a hollow filled with standing water to a level, with no source: where it was asked, the level, and the hollow's water stored literally as a carve stores its sealed oxbow lake's (D216): the tiles (ascending), their floors, the depths to the level, clean. Every settle starts the hollow from it and the game's rules evaporate it. The engine checks the hollow, measured on the map now, holds water at that level and is the one stored.",
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "level", "lake"],
      "properties": {
        "at": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/coordinate" } },
        "level": { "type": "number", "exclusiveMinimum": 0, "maximum": 64 },
        "lake": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tiles", "floor", "depth", "contamination"],
          "properties": {
            "tiles": { "type": "array", "minItems": 1, "maxItems": 65536, "items": { "type": "integer", "minimum": 0, "maximum": 65535 } },
            "floor": { "type": "array", "maxItems": 65536, "items": { "type": "number", "minimum": 0, "maximum": 64 } },
            "depth": { "type": "array", "maxItems": 65536, "items": { "type": "number", "exclusiveMinimum": 0, "maximum": 64 } },
            "contamination": { "type": "array", "maxItems": 65536, "items": { "const": 0 } }
          }
        }
      }
    },
    "tile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": { "x": { "$ref": "#/$defs/coordinate" }, "y": { "$ref": "#/$defs/coordinate" } }
    },
    "objectComponents": {
      "description": "The components of a placed object or a patch on them, in the game's own names. The options the editor sets are typed here; the engine adds what depends on the object: a water object's strength is at most 8 for each tile it emits into (72 for a badwater source, 32 for a seep) and has no lower bound, a sink is negative; a start delay is a cycle of 1 or more and days of 0 or more, and an aquifer has none; an unstable core's radius is a whole number from 0 to 5 and its countdown is always on; a reserve holds one good of its kind up to its capacity (160 a pile, 200 a warehouse, 300 a tank). Each refusal says which.",
      "type": "object",
      "properties": {
        "WaterSource": {
          "type": "object",
          "properties": {
            "SpecifiedStrength": { "type": "number" },
            "CurrentStrength": { "type": "number" }
          }
        },
        "WaterDepthStrengthModifier": { "type": "object", "properties": { "CurrentModifier": { "type": "number" } } },
        "TimeActivatedComponent": {
          "type": "object",
          "properties": {
            "IsEnabled": { "type": "boolean" },
            "CyclesUntilCountdownActivation": { "type": "number" },
            "DaysUntilActivation": { "type": "number" },
            "DaysPassed": { "type": "number" }
          }
        },
        "UnstableCore": { "type": "object", "properties": { "ExplosionRadius": { "type": "number" } } },
        "FixedStockpile": { "type": "object", "properties": { "FixedGoodId": { "type": "string" } } },
        "SingleGoodAllower": { "type": "object", "properties": { "AllowedGood": { "type": "string" } } },
        "Inventory:Stockpile": { "type": "object" },
        "StockpileVisualizers": { "type": "object", "properties": { "CurrentGood": { "type": "string" } } }
      }
    },
    "paintObjects": {
      "description": "A brush stroke of objects (D235, D338): trees (Pine, Birch or Oak), bushes (BlueberryBush), succulents (Succulent), mixed woods, ruin fields or thorn patches, over the tiles it covers. It is planned on the map as it stands (dry, free ground, one level for a ruin field) and placed as one step; the log keeps the objects it placed, so a replay never plans again. The density is how densely they land: from a sparse scatter to a dense grove, and the share of the ground a ruin field or a thorn patch covers. The age (trees, succulents, woods): grown, or mixed with saplings. The seed makes the same stroke on the same map place the same objects.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "area", "density", "seed"],
      "properties": {
        "kind": { "enum": ["trees", "bushes", "succulents", "woods", "ruins", "thorns"] },
        "template": { "type": "string" },
        "area": { "$ref": "#/$defs/runs" },
        "density": { "type": "number", "minimum": 0.05, "maximum": 1 },
        "age": { "enum": ["grown", "mixed"] },
        "seed": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
      }
    }
  }
}
